# finance-copilot — environment template. Copy to `.env` and fill in.
# The refresh skills DO NOT auto-type these; you log into each bank yourself in a
# visible Chrome window. These are optional reference/convenience values only and
# are never required for the manual-login scrape flow. NEVER commit your real .env.

# Where your private financial data lives (per-source raw/ + normalized/ + digested/).
# If unset, scripts fall back to ./data relative to the working directory.
FINANCE_DATA_DIR=

# --- Optional: only if you run the private israeli-bank MCP add-on -------------
# The public plugin does NOT ship or require this MCP. If you choose to run it,
# keep credentials in YOUR OWN private .mcp.json / secure storage — never here in
# a shared file.
# DISCOUNT_ID=
# DISCOUNT_PASSWORD=
# AMEX_ID=
# AMEX_CARD6_DIGITS=
# AMEX_PASSWORD=
