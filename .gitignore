# Contains bank credentials in plaintext — never commit
.mcp.json
.env

# Cloned + built MCP server (large, regenerable via git clone + npm run build)
israeli-bank-mcp/

# Scraped financial data & personal documents — never commit
data/*
# …but version the pipeline code (Python) that lives alongside the data.
# Re-include directories so nested scripts are reachable, then the scripts
# themselves; raw/ and normalized/ dumps stay ignored via data/*/raw etc. below.
!data/forecast.py
!data/digest.py
!data/cashflow.py
!data/projection.py
!data/*/
data/*/raw/
data/*/normalized/
!data/*/normalize.py
# Re-including data/*/ above exposes these — they hold real balances/account
# numbers (digested output) or are throwaway bytecode. Never commit.
data/digested/
data/__pycache__/
riseup-data/
riseup-session.json
receipts/
reports/
statements/
logs/
*.xlsx
.~lock.*#

# Browser automation session artifacts
.playwright/
.playwright-cli/

# macOS
.DS_Store

# Build artifacts
riseup-skill.zip
