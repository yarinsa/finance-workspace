# Contains bank credentials in plaintext — never commit
.mcp.json
.env

# Project-local household memory — real personal facts (birth date, loan notes).
# Part of the project architecture (loaded via CLAUDE.md) but never committed;
# back it up alongside the scraped data, not in git.
MEMORY.md

# Cloned + built MCP server (large, regenerable via git clone + npm run build)
israeli-bank-mcp/

# Scraped financial data & personal documents — never commit
data/*
# …but version the pipeline code (Python) that lives alongside the data.
# Re-include directories so nested scripts are reachable, then the scripts
# themselves; raw/ and normalized/ dumps stay ignored via data/*/raw etc. below.
!data/forecast.py
!data/digest.py
!data/cashflow.py
!data/projection.py
!data/detect_freeze.py
!data/*/
data/*/raw/
data/*/normalized/
!data/*/normalize.py
# Pipeline tests + their fixtures travel with the code (pytest reads data/tests/).
!data/conftest.py
!data/tests/
!data/tests/**
data/tests/__pycache__/
# Re-including data/*/ above exposes these — they hold real balances/account
# numbers (digested output) or are throwaway bytecode. Never commit.
data/digested/
data/__pycache__/
# User-confirmed freeze params (holds real per-track loan payment amounts).
data/freeze.json
riseup-data/
riseup-session.json
receipts/
reports/
statements/
logs/
*.xlsx
.~lock.*#

# Browser automation session artifacts
.playwright/
.playwright-cli/

# macOS
.DS_Store

# Build artifacts
riseup-skill.zip

# Python virtualenv for running the test suite
.venv/

# terraform — state holds the Cognito client secret; never commit
infra/.terraform/
infra/.build/
infra/terraform.tfstate*
infra/tfplan
infra/*.tfvars

# Dashboard screenshots hold real financial figures — never commit
.claude/screenshots/
.claude/skills/dashboard-screenshots/node_modules/
