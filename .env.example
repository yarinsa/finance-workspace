# Copy to .env (gitignored) and fill in. Never commit .env.

# Bank Discount online banking (convenience only; the user logs in in-browser).
DISCOUNT_ID=
DISCOUNT_PASSWORD=

# CAL credit cards (convenience only; login is 2FA, done by the user).
CAL_ID=
CAL_CARD6_DIGITS=
# CAL headless self-login (scrapers/cal/scrape.mjs): the cal-online username + password.
CAL_USERNAME=
CAL_PASSWORD=

# Local Postgres from docker-compose.yml (the transactions database).
POSTGRES_USER=finance
POSTGRES_PASSWORD=
POSTGRES_DB=finance
POSTGRES_PORT=5432
# Spelled out in full: data/digest.py and db/ read it literally (no ${...} expansion).
DATABASE_URL=postgresql://finance:<POSTGRES_PASSWORD>@127.0.0.1:5432/finance

# --- Ledger API (api/README.md; docs/ledger-api.md) --------------------------------------
# `docker compose up -d api` starts it (or set COMPOSE_PROFILES=api to include it in `up -d`).
# Password of the least-privilege Postgres role finance_api. db/ledger.py sets it on the role
# whenever it connects (run `python3 db/ledger.py migrate` once). Use URL-safe characters
# (letters and digits): it is embedded in a connection URL.
FINANCE_API_DB_PASSWORD=
# Random string CloudFront adds as X-Origin-Secret (Terraform random_password). The API
# refuses to start without it. Also read by the Vite dev proxy.
FINANCE_API_ORIGIN_SECRET=
# The Cognito user pool that signs the dashboard login (same values as infra/).
FINANCE_API_COGNITO_REGION=
FINANCE_API_COGNITO_POOL_ID=
FINANCE_API_COGNITO_CLIENT_ID=
# Comma-separated emails allowed to edit.
FINANCE_API_ALLOWED_EMAILS=
# Local development only, never in compose: skips the JWT check and uses this email as the
# audit actor. The origin secret is still required. Run the API outside Docker to use it.
FINANCE_API_DEV_USER=
# Where the API sends rebuild signals when run outside Docker (compose sets temporal:7233).
TEMPORAL_ADDRESS=localhost:7233
