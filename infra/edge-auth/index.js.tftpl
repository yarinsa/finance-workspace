"use strict";

/**
 * CloudFront viewer-request gate for the Plangram dashboard.
 *
 * Every request — the HTML, the JS bundle, and critically the digested
 * financial JSON — passes through here first. Without a valid Cognito session
 * the request never reaches S3; it is redirected to the hosted login instead.
 *
 * Why verification is done by hand: Lambda@Edge cannot read environment
 * variables and bundling a JWT library would mean shipping node_modules to the
 * edge. The JWKS fetch + RSA verify below is small enough to inline, and
 * verifying the signature is the whole point — decoding a token without
 * checking it would accept anything a caller chose to send.
 */

const https = require("https");
const crypto = require("crypto");

const CONFIG = ${config_json};

const ISSUER = `https://cognito-idp.$${CONFIG.region}.amazonaws.com/$${CONFIG.user_pool_id}`;
const JWKS_URL = `$${ISSUER}/.well-known/jwks.json`;

// Cached across invocations on a warm container. Keys rotate rarely; a miss
// simply refetches.
let jwksCache = null;

function httpsGet(url) {
  return new Promise((resolve, reject) => {
    https
      .get(url, (res) => {
        let body = "";
        res.on("data", (c) => (body += c));
        res.on("end", () => {
          if (res.statusCode < 200 || res.statusCode >= 300) {
            reject(new Error(`GET $${url} -> $${res.statusCode}`));
            return;
          }
          resolve(body);
        });
      })
      .on("error", reject);
  });
}

function httpsPostForm(url, form, authHeader) {
  return new Promise((resolve, reject) => {
    const payload = new URLSearchParams(form).toString();
    const u = new URL(url);
    const req = https.request(
      {
        hostname: u.hostname,
        path: u.pathname,
        method: "POST",
        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
          "Content-Length": Buffer.byteLength(payload),
          Authorization: authHeader,
        },
      },
      (res) => {
        let body = "";
        res.on("data", (c) => (body += c));
        res.on("end", () => {
          if (res.statusCode < 200 || res.statusCode >= 300) {
            reject(new Error(`POST $${url} -> $${res.statusCode}: $${body}`));
            return;
          }
          resolve(JSON.parse(body));
        });
      }
    );
    req.on("error", reject);
    req.write(payload);
    req.end();
  });
}

async function getJwks() {
  if (jwksCache) return jwksCache;
  jwksCache = JSON.parse(await httpsGet(JWKS_URL)).keys;
  return jwksCache;
}

function b64urlToBuf(s) {
  return Buffer.from(s.replace(/-/g, "+").replace(/_/g, "/"), "base64");
}

/**
 * Verify an RS256 Cognito ID token: signature against the pool's JWKS, then
 * issuer, audience, use and expiry. Returns the claims, or null on any failure.
 * Never throws to the caller — a malformed token is simply "not authenticated".
 */
async function verify(token) {
  try {
    const parts = token.split(".");
    if (parts.length !== 3) return null;

    const header = JSON.parse(b64urlToBuf(parts[0]).toString("utf8"));
    const claims = JSON.parse(b64urlToBuf(parts[1]).toString("utf8"));

    if (header.alg !== "RS256") return null;

    const keys = await getJwks();
    const jwk = keys.find((k) => k.kid === header.kid);
    if (!jwk) return null;

    const pubKey = crypto.createPublicKey({ key: jwk, format: "jwk" });
    const ok = crypto.verify(
      "RSA-SHA256",
      Buffer.from(`$${parts[0]}.$${parts[1]}`),
      pubKey,
      b64urlToBuf(parts[2])
    );
    if (!ok) return null;

    const now = Math.floor(Date.now() / 1000);
    if (claims.iss !== ISSUER) return null;
    if (claims.aud !== CONFIG.client_id) return null;
    if (claims.token_use !== "id") return null;
    if (typeof claims.exp !== "number" || claims.exp <= now) return null;

    return claims;
  } catch (err) {
    console.log("verify failed:", err.message);
    return null;
  }
}

function parseCookies(headers) {
  const out = {};
  const raw = headers.cookie;
  if (!raw) return out;
  for (const entry of raw) {
    for (const pair of entry.value.split(";")) {
      const i = pair.indexOf("=");
      if (i === -1) continue;
      out[pair.slice(0, i).trim()] = pair.slice(i + 1).trim();
    }
  }
  return out;
}

function redirectToLogin(host) {
  const target = new URL(`https://$${CONFIG.hosted_domain}/login`);
  target.searchParams.set("client_id", CONFIG.client_id);
  target.searchParams.set("response_type", "code");
  target.searchParams.set("scope", "openid email");
  target.searchParams.set("redirect_uri", `https://$${host}/_callback`);

  return {
    status: "302",
    statusDescription: "Found",
    headers: {
      location: [{ key: "Location", value: target.toString() }],
      "cache-control": [{ key: "Cache-Control", value: "no-store" }],
    },
  };
}

function redirect(location) {
  return {
    status: "302",
    statusDescription: "Found",
    headers: {
      location: [{ key: "Location", value: location }],
      "cache-control": [{ key: "Cache-Control", value: "no-store" }],
    },
  };
}

/**
 * Managed login's passkey enrolment page. It needs a live managed-login
 * session on the auth domain, which exists right after signing in; the
 * redirect_uri must be a registered callback, hence /_callback.
 */
function redirectToPasskeyEnrolment() {
  const target = new URL(`https://$${CONFIG.hosted_domain}/passkeys/add`);
  target.searchParams.set("client_id", CONFIG.client_id);
  target.searchParams.set("redirect_uri", `https://$${CONFIG.site_domain}/_callback`);
  return redirect(target.toString());
}

/**
 * True for the ledger API (/api/...). Those requests come from fetch(), not a
 * navigation, so they must get a machine-readable status instead of a redirect
 * to an HTML login page.
 */
function isApiPath(uri) {
  return uri.startsWith("/api/");
}

function unauthenticatedJson() {
  return {
    status: "401",
    statusDescription: "Unauthorized",
    headers: {
      "content-type": [{ key: "Content-Type", value: "application/json" }],
      "cache-control": [{ key: "Cache-Control", value: "no-store" }],
    },
    body: JSON.stringify({ error: "unauthenticated" }),
  };
}

/**
 * SPA routing. A URI whose last segment has no "." is a client-side route
 * (/spending, /runway/…), so serve the app shell. Anything with an extension
 * (/data/cashflow.json, /assets/app.js) is a real object and is left alone, so
 * a genuinely missing asset is still the S3 403.
 *
 * This lives here, after the auth check, rather than in a CloudFront Function
 * because a behavior may not have both a CloudFront Function and Lambda@Edge on
 * viewer-request. Mutating the URI only after authentication also means an
 * unauthenticated caller never learns which paths exist.
 */
function rewriteSpaRoute(request) {
  const last = request.uri.split("/").pop();
  if (!last.includes(".")) request.uri = "/index.html";
}

/**
 * Tenant gate for the published data. A tenant's files live under /data/t/<tenant_id>/ and
 * are served only to a session whose Cognito groups include "tenant-<tenant_id>" (the group
 * mirrors the membership; infra/tenant-groups.sh keeps it in step). The master tenant's
 * files keep the old /data/<file>.json paths; they are gated the same way once
 * CONFIG.enforce_tenant_data is on (it is off until the groups exist, so the household is
 * never locked out of its own data during the rollout). The check uses the signed id
 * token only: this function has no database.
 */
const TENANT_DATA = /^\/data\/t\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\/[A-Za-z0-9_-]+\.json$/;   // one flat file: no ".." or nested paths

function tenantAllowed(uri, claims) {
  const groups = Array.isArray(claims["cognito:groups"]) ? claims["cognito:groups"] : [];
  const m = TENANT_DATA.exec(uri);
  if (m) return groups.includes(`tenant-$${m[1]}`);
  if (uri.startsWith("/data/t/")) return false; // anything else under the tenant prefix is malformed: refuse
  if (uri.startsWith("/data/") && CONFIG.enforce_tenant_data) {
    return groups.includes(`tenant-$${CONFIG.default_tenant_id}`);
  }
  return true;
}

function denied(reason) {
  return {
    status: "403",
    statusDescription: "Forbidden",
    headers: {
      "content-type": [{ key: "Content-Type", value: "text/plain; charset=utf-8" }],
      "cache-control": [{ key: "Cache-Control", value: "no-store" }],
    },
    body: `Forbidden: $${reason}`,
  };
}

/** Cookie holding Cognito's refresh token, next to the ID-token session cookie. */
const REFRESH_COOKIE = `$${CONFIG.cookie_name}_rt`;

function cookie(name, value, maxAge) {
  return {
    key: "Set-Cookie",
    value: `$${name}=$${value}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=$${maxAge}`,
  };
}

/** The ID-token session cookie; its lifetime tracks the token so an expired one cannot linger. */
function sessionCookie(idToken, claims) {
  return cookie(CONFIG.cookie_name, idToken, Math.max(60, claims.exp - Math.floor(Date.now() / 1000)));
}

function basicAuth() {
  return `Basic $${Buffer.from(`$${CONFIG.client_id}:$${CONFIG.client_secret}`).toString("base64")}`;
}

/**
 * Trade the refresh cookie for a new ID token. Returns {token, claims}, or null when the refresh
 * token is missing, expired or revoked (the caller then falls back to the login redirect).
 */
async function refreshSession(refreshToken) {
  try {
    const tokens = await httpsPostForm(
      `https://$${CONFIG.hosted_domain}/oauth2/token`,
      { grant_type: "refresh_token", client_id: CONFIG.client_id, refresh_token: refreshToken },
      basicAuth()
    );
    const claims = await verify(tokens.id_token);
    return claims ? { token: tokens.id_token, claims } : null;
  } catch (err) {
    console.log("refresh failed:", err.message);
    return null;
  }
}

/**
 * Send the browser straight back to the same URL with the renewed session cookie. 307 keeps the
 * method and body, and fetch()/EventSource follow it, so pages, /data, /api and SSE all renew
 * silently instead of bouncing through the hosted login.
 */
function retryWithSession(request, idToken, claims) {
  const qs = request.querystring ? `?$${request.querystring}` : "";
  return {
    status: "307",
    statusDescription: "Temporary Redirect",
    headers: {
      location: [{ key: "Location", value: `$${request.uri}$${qs}` }],
      "cache-control": [{ key: "Cache-Control", value: "no-store" }],
      "set-cookie": [sessionCookie(idToken, claims)],
    },
  };
}

/**
 * Exchange the OAuth code for tokens and set the session cookie.
 * The cookie is HttpOnly + Secure + SameSite=Lax so the browser will not expose
 * it to page scripts, which matters because the page renders real account data.
 */
async function handleCallback(request, host) {
  const params = new URLSearchParams(request.querystring || "");
  const code = params.get("code");
  // The passkey enrolment page returns here with no code. Nothing is granted
  // by this redirect — "/" re-checks the session like any other request.
  if (!code) return redirect("/");

  let tokens;
  try {
    tokens = await httpsPostForm(
      `https://$${CONFIG.hosted_domain}/oauth2/token`,
      {
        grant_type: "authorization_code",
        client_id: CONFIG.client_id,
        code,
        redirect_uri: `https://$${host}/_callback`,
      },
      basicAuth()
    );
  } catch (err) {
    console.log("token exchange failed:", err.message);
    return denied("token exchange failed");
  }

  const claims = await verify(tokens.id_token);
  if (!claims) return denied("issued token failed verification");

  const cookies = [sessionCookie(tokens.id_token, claims)];
  if (tokens.refresh_token) cookies.push(cookie(REFRESH_COOKIE, tokens.refresh_token, CONFIG.refresh_max_age));

  return {
    status: "302",
    statusDescription: "Found",
    headers: {
      location: [{ key: "Location", value: "/" }],
      "cache-control": [{ key: "Cache-Control", value: "no-store" }],
      "set-cookie": cookies,
    },
  };
}

exports.handler = async (event) => {
  const request = event.Records[0].cf.request;
  const headers = request.headers;
  const host = headers.host[0].value;

  // One canonical origin: the session cookie, the OAuth redirect_uri and the
  // passkey relying party all assume it. The raw *.cloudfront.net name is
  // bounced before anything else happens.
  if (host !== CONFIG.site_domain) {
    const qs = request.querystring ? `?$${request.querystring}` : "";
    return redirect(`https://$${CONFIG.site_domain}$${request.uri}$${qs}`);
  }

  if (request.uri === "/_callback") {
    return handleCallback(request, host);
  }

  if (request.uri === "/_logout") {
    return {
      status: "302",
      statusDescription: "Found",
      headers: {
        location: [{ key: "Location", value: "/" }],
        "set-cookie": [cookie(CONFIG.cookie_name, "", 0), cookie(REFRESH_COOKIE, "", 0)],
      },
    };
  }

  const api = isApiPath(request.uri);
  const reject = () => (api ? unauthenticatedJson() : redirectToLogin(host));

  const cookies = parseCookies(headers);
  const token = cookies[CONFIG.cookie_name];
  const claims = token ? await verify(token) : null;
  if (!claims) {
    // Expired (or missing) session but a refresh token: renew without the hosted login.
    const refreshToken = cookies[REFRESH_COOKIE];
    const renewed = refreshToken ? await refreshSession(refreshToken) : null;
    return renewed ? retryWithSession(request, renewed.token, renewed.claims) : reject();
  }

  // Authenticated API call: straight through to the origin, untouched.
  if (api) return request;

  // Signed-in only: enrolling a passkey is a privileged action.
  if (request.uri === "/_passkey") return redirectToPasskeyEnrolment();

  // Another tenant's (or, once enforced, the master tenant's) data needs that tenant's group.
  if (!tenantAllowed(request.uri, claims)) return denied("not a member of this tenant");

  // Authenticated: serve the app shell for client-side routes, else pass
  // through to S3 untouched.
  rewriteSpaRoute(request);
  return request;
};
